# Everything here is either a secret, a local working copy, or regenerable.
# One rule: if it is not committed, it lives in `_local/`, `data/` or `memory/`.

# secrets
.env
.env.*
.env.*.local
!.env.example

# local-only working material — never committed (see _local/README.md)
_local/
memory/
_archive/

# deps / build / runtime data
node_modules
node_modules.nosync
.next
out/
data/
next-env.d.ts
*.tsbuildinfo

# os
.DS_Store

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CasaEnComú browser reader — air/README.md. Install: cp to ~/Library/LaunchAgents/ then
	     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.kenobi.casaencomu-reader.plist
	     A LaunchAgent, not a Daemon: it opens a real Chrome window, so it needs the logged-in GUI
	     session. CASA_CAPTURE_TOKEN is any member's bookmarklet token; keep it out of this file
	     and out of the repository — the wrapper reads it from ~/.config/casaencomu/reader.env. -->
	<key>Label</key>
	<string>com.kenobi.casaencomu-reader</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>. "$HOME/.config/casaencomu/reader.env" &amp;&amp; exec /usr/local/bin/node "$HOME/.local/bin/casaencomu-reader.mjs" >>"$HOME/Library/Logs/casaencomu-reader.log" 2>&amp;1</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>60</integer>
</dict>
</plist>
